{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Download MNIST Dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/data/download_mnist.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run NN Example (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_example_NN.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run CNN Example (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_example_CNN.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run DBN Example (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_example_DBN.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run SAE Example (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_example_SAE.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run CAE Example (Interactive)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests/test_example_CAE.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Run Current Test (Headless)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DNN_NONINTERACTIVE": "1",
                "MPLBACKEND": "Agg"
            }
        },
        {
            "name": "Generate All Training GIFs",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/generate_training_gifs.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DNN_NONINTERACTIVE": "1",
                "MPLBACKEND": "Agg"
            }
        },
        {
            "name": "Run All Models End-to-End",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_all.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DNN_NONINTERACTIVE": "1",
                "MPLBACKEND": "Agg"
            }
        }
    ]
}
